[Unit]
Description=Start agy-reader sync when agy or Antigravity 2.0 writes session data

[Path]
# agy re-creates cli.log (a symlink into log/) and drops a fresh
# log/cli-<timestamp>.log every time its language-server daemon starts, so a new
# entry in log/ is a reliable "agy just started" signal. We watch the directory
# rather than the cli.log symlink because a replaced symlink is the unreliable
# inotify case.
PathModified=%h/.gemini/antigravity-cli/log
# Also react to live transcript writes, which re-arm the sync after the service
# has idle-exited (and covers the case where agy was already running when the
# .path unit was started).
PathModified=%h/.gemini/antigravity-cli/conversations
# A bare `agy-reader --watch` also covers the Antigravity 2.0 (IDE) store when
# it exists, so IDE activity must re-arm the service too. The IDE's language
# server logs under the user config dir (%E = $XDG_CONFIG_HOME or ~/.config),
# giving the "IDE just started" signal; its conversations/ covers transcript
# writes while the service is idle-exited. On machines without the IDE these
# paths never exist and the watches sit idle on the nearest ancestor.
PathModified=%E/Antigravity/logs
PathModified=%h/.gemini/antigravity/conversations

[Install]
WantedBy=default.target
